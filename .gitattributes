# Store website source with consistent LF endings on every platform.
* text=auto eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.sh text eol=lf

# Leave images, downloads and font files byte-for-byte unchanged.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.pdf -text
*.woff -text
*.woff2 -text
*.ttf -text
*.eot -text
